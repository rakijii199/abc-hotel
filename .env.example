# =====================================================================
# ABC Hotel & Restaurant Management — Production Environment Template
# =====================================================================
# DO NOT COMMIT REAL SECRETS. Store production secrets in Google Cloud Secret Manager.

# Server Execution Environment
PORT=8080
NODE_ENV=production

# Security & Authentication (Store in Google Cloud Secret Manager)
# Required: 256-bit strong cryptographic secret for signing JSON Web Tokens
JWT_SECRET=<STRONG_RANDOM_256BIT_SECRET>

# Google Cloud / Firebase Firestore Configuration
FIREBASE_PROJECT_ID=restaurant-com-2a275
FIRESTORE_DATABASE_ID=ai-studio-abchotelluxurydi-cfa9a1a9-b5f3-4a06-9e30-0167035de53d
# Optional: Dedicated Google Cloud Service Account JSON for Cloud Run (in Secret Manager)
FIREBASE_SERVICE_ACCOUNT_KEY=<SERVICE_ACCOUNT_CREDENTIALS_JSON>

# Payment Gateway (Razorpay - Store keys in Secret Manager)
RAZORPAY_KEY_ID=<RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<RAZORPAY_WEBHOOK_SECRET>
PAYMENT_ENVIRONMENT=production

# CORS Security: Comma-separated list of allowed production domains
ALLOWED_ORIGINS=https://restaurant-com-2a275.web.app,https://restaurant-com-2a275.firebaseapp.com

# Hosted App URL & Integrations
APP_URL=https://restaurant-com-2a275.web.app
GEMINI_API_KEY=<GEMINI_API_KEY>
